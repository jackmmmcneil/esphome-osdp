# Copy to secrets.yaml (or merge into your ESPHome secrets.yaml)
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
fallback_ap_password: "change-me-please"
api_key: "generate with: openssl rand -base64 32"

# Secure Channel Base Key: 16 bytes as 32 hex chars. Generate with:
#   openssl rand -hex 16
osdp_scbk: "00112233445566778899aabbccddeeff"

# Cards, PINs and schedules are no longer kept here: manage them from Home
# Assistant (see the api actions in door.yaml).
